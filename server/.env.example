# Base PostgreSQL. En local : postgres://postgres:MOT_DE_PASSE@localhost:5432/boutique
# En ligne (Neon, Supabase…) : colle l'URL fournie, avec ?sslmode=require
DATABASE_URL=

PORT=5000
# Adresse publique du site (sert aux redirections après paiement)
CLIENT_URL=http://localhost:5173

# Stripe (Europe) — https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
# Secret du webhook : https://dashboard.stripe.com/test/webhooks  →  /api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=

# NotchPay (Mobile Money Cameroun) — https://business.notchpay.co  →  Paramètres > Clés API
NOTCHPAY_PUBLIC_KEY=
# « Hash key » du webhook  →  /api/webhooks/notchpay
NOTCHPAY_WEBHOOK_HASH=
